HF_TOKEN=

# vLLM
HF_VLM_REPO=google/gemma-4-E4B-it
VLM_MODEL_NAME=gemma-4-E4B-it
VLM_BASE_URL=http://localhost:9000/v1
VLM_TIMEOUT=60

# Whisper
# Two backends, two model formats: NVIDIA (Thor) runs transformers + stock HF
# checkpoint; Intel (Panther Lake NPU, Arc GPU) runs openvino_genai on a
# pre-converted OV-IR. Compose picks the right pair based on the active
# profile (XPU_CORE=nvidia-gpu vs intel-xpu).
HF_WHISPER_REPO_NVIDIA=openai/whisper-large-v3
WHISPER_MODEL_NAME_NVIDIA=whisper-large-v3
HF_WHISPER_REPO_INTEL=movensys/whisper-large-v3-turbo-fp16-ov-npu
WHISPER_MODEL_NAME_INTEL=whisper-large-v3-turbo-fp16-ov-npu
WHISPER_BASE_URL=http://localhost:9010/v1
WHISPER_TIMEOUT=60
# Uncomment on Panther Lake (or any host where /dev/accel/accel0 exists) to
# expose the NPU to the container. Leave unset on Arc-only hosts; the server
# auto-detects and falls back to the GPU plugin via /dev/dri.
WHISPER_NPU_DEVICE=/dev/accel